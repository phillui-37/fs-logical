<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>fslogical-codegen</AssemblyName>
    <!-- Pack as a .NET global tool so users can install with: dotnet tool install -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fslogical-codegen</ToolCommandName>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FsLogical\FsLogical.fsproj" />
  </ItemGroup>

</Project>
