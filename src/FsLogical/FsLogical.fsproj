<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- AOT and trim compatibility flags.
         IsAotCompatible already implies IsTrimmable, EnableTrimAnalyzer and
         EnableAotAnalyzer, but we set them explicitly so that their intent is
         visible in the project file and so they can be overridden individually
         if needed in the future. -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Term.fs" />
    <Compile Include="Unification.fs" />
    <Compile Include="Solver.fs" />
    <Compile Include="DSL.fs" />
    <Compile Include="PrologImport.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharpx.Collections" Version="3.1.0" />
  </ItemGroup>

</Project>
